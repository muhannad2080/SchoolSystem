  <!-- يوثق عنصر XML المستخدم في إعدادات المشروع أو موارده. -->
  <Profiles>
    <!-- يوثق عنصر XML المستخدم في إعدادات المشروع أو موارده. -->
    <Profile Name="(Default)" />
  <!-- يوثق عنصر XML المستخدم في إعدادات المشروع أو موارده. -->
  </Profiles>
  <!-- يوثق عنصر XML المستخدم في إعدادات المشروع أو موارده. -->
  <Settings />
<!-- يوثق عنصر XML المستخدم في إعدادات المشروع أو موارده. -->
</SettingsFile>
