<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SchoolSystem.SetupBootstrapper</RootNamespace>
    <AssemblyName>SchoolSystem-SetupBootstrapper</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>..\..\Assets\Brand\SchoolSystem.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <PayloadZip Condition="'$(PayloadZip)' == ''">Payload.zip</PayloadZip>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == ''">
    <Configuration>Release</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <None Include="app.manifest" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="Payload.zip" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="ValidatePayload" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(PayloadZip)')"
      Text="Payload.zip غير موجود. يجب أن ينشئ Build-Installers.ps1 الحمولة قبل بناء Setup.exe." />
  </Target>
</Project>
